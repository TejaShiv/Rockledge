<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tally.rebuild</string>

	<key>ProgramArguments</key>
	<array>
		<string>__SCRIPT__</string>
	</array>

	<!-- Twice a day. The script does nothing until the profile is inside
	     its last 48 hours, so this is four chances before any deadline. -->
	<!-- Every quarter of an hour, not twice a day.

	     The phone answers a pairing query maybe half the time it is sitting
	     on the same router: its radio sleeps, and the tunnel comes back only
	     once it has been awake recently. Two scheduled attempts a day turn a
	     coin flip into a real chance of missing a whole deadline, and that is
	     what happened — the window opened and closed with no run inside it.
	     Ninety-six attempts cost a second each and make missing it unlikely.

	     StartInterval also survives a sleeping Mac better than a calendar
	     entry: launchd runs an elapsed interval shortly after waking, where
	     an appointment whose minute passed in deep sleep is simply gone. -->
	<key>StartInterval</key>
	<integer>900</integer>

	<!-- And at login. launchd also runs a missed calendar job once the Mac
	     wakes, so a closed lid at 3 AM only delays it. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/tally-rebuild.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/tally-rebuild.err.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
