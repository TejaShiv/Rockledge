<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Exposes Documents in the Files app, so kalla.json can be read and
	     edited by hand. Xcode generates the rest of this file from the
	     INFOPLIST_KEY_* build settings and merges it over these keys;
	     UIFileSharingEnabled has no such setting, which is why the file
	     exists at all. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- When-in-use only, and only asked for when the MBTA screen opens.
	     There is no "always" key here on purpose: the app has no reason to
	     know where you are while it is closed. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Finds the nearest bus stop so the app can show you the next arrivals. Only used while the MBTA screen is open.</string>

	<!-- Canvas assignments are refreshed in the background so reminders
	     stay honest: work handed in on a laptop stops nagging, and work
	     posted mid-week gets a reminder without the app being opened. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>steps.anynameyoulike.canvas.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
